# AI Quote Tool Configuration

# Server Configuration
PORT=3002

# OpenClaw API Configuration
# Get your API key from https://api.moikas.com
OPENCLAW_API_URL=https://api.moikas.com/v1
OPENCLAW_API_KEY=your_api_key_here
OPENCLAW_MODEL=anthropic/claude-sonnet-4-5-20250929

# CORS Configuration
# In production, set this to your frontend domain
# Example: CORS_ORIGINS=https://quote.moikas.com,https://moikas.com
CORS_ORIGINS=*

# Rate Limiting (optional overrides)
# QUOTES_PER_MONTH=50
# MESSAGES_PER_CONVERSATION=30
